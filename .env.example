# Database
DATABASE_URL=sqlite:///./data/portfolio.db

# APIs (add your keys here, then copy to .env)
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# EDGAR requires every request to declare who is making it (SEC fair-access
# policy); an undeclared tool is refused with HTTP 403. It lives here and not
# in config.toml because config.toml is tracked and the repository is public.
EDGAR_USER_AGENT=Your Name your_email_here